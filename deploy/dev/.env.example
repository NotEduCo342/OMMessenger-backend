# Environment variables for OM Messenger Backend (Development)

# Server Configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# Public API base URL (used to generate absolute media URLs)
PUBLIC_API_BASE_URL=http://localhost:8080/api
PUBLIC_JOIN_BASE_URL=http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=om_messenger
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=dev_secret_key

# MinIO Configuration
MINIO_ROOT_USER=om_minio_admin
MINIO_ROOT_PASSWORD=change_this_strong_password_min_32_chars
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=om-avatars

# S3 Configuration (Backend maps these to MinIO)
S3_ENDPOINT=minio:9000
S3_USE_SSL=false
S3_BUCKET=om-avatars
S3_ACCESS_KEY=om_minio_admin
S3_SECRET_KEY=change_this_strong_password_min_32_chars

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
