# Environment variables for OM Messenger Backend (Production Swarm)

# Server Configuration
PORT=8080
ALLOWED_ORIGINS=https://yourdomain.com

# Public API base URL (used to generate absolute media URLs)
PUBLIC_API_BASE_URL=https://api.yourdomain.com
PUBLIC_JOIN_BASE_URL=https://yourdomain.com

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this_to_a_secure_password
DB_NAME=om_messenger
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=change_this_to_a_super_secret_key_in_production

# MinIO Configuration
MINIO_ROOT_USER=om_minio_admin
MINIO_ROOT_PASSWORD=change_this_strong_password_min_32_chars
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=om-avatars

# S3 Configuration (Backend maps these to MinIO)
S3_ENDPOINT=minio:9000
S3_USE_SSL=false
S3_BUCKET=om-avatars
S3_ACCESS_KEY=om_minio_admin
S3_SECRET_KEY=change_this_strong_password_min_32_chars

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change_this_to_a_secure_redis_password
REDIS_DB=0
